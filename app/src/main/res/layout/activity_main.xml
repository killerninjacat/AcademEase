<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorSurface"
    tools:context="com.nithinbalan.academease.activities.MainActivity">

    <nl.dionsegijn.konfetti.xml.KonfettiView
        android:id="@+id/konfettiView"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <!-- Top App Bar -->
        <com.google.android.material.appbar.AppBarLayout
            android:id="@+id/appBarLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <com.google.android.material.appbar.MaterialToolbar
                android:id="@+id/topAppBar"
                android:layout_width="match_parent"
                android:layout_height="?attr/actionBarSize"
                app:title="AcademEase"
                app:titleCentered="true"
                app:titleTextAppearance="@style/TopBar"
                app:titleTextColor="?attr/colorOnSurface" />

        </com.google.android.material.appbar.AppBarLayout>

        <!-- Welcome Text -->
        <TextView
            android:id="@+id/welcome"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:fontFamily="@font/spacemono_bold"
            android:paddingHorizontal="16dp"
            android:text="Hello, User!"
            android:textAlignment="center"
            android:textAllCaps="false"
            android:textAppearance="@style/TextAppearance.Material3.HeadlineLarge"
            android:textColor="?attr/colorOnSurface"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/appBarLayout" />

        <!-- Card Container for Main Options -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/optionsCardView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="16dp"
            android:layout_marginTop="32dp"
            app:cardCornerRadius="16dp"
            app:cardElevation="4dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/welcome">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/timetableButton"
                    style="@style/Widget.Material3.Button.OutlinedButton.Icon"
                    android:layout_width="match_parent"
                    android:layout_height="64dp"
                    android:layout_marginBottom="8dp"
                    android:fontFamily="@font/spacemono_bold"
                    android:text="Timetable"
                    app:strokeColor="?attr/colorOnSurface"
                    android:textColor="?attr/colorOnSurface"
                    android:textAlignment="textStart"
                    android:textSize="18sp"
                    app:icon="@drawable/ic_calendar"
                    app:iconGravity="start"
                    app:iconPadding="16dp"
                    app:iconSize="24dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/attendanceButton"
                    style="@style/Widget.Material3.Button.OutlinedButton.Icon"
                    android:layout_width="match_parent"
                    android:layout_height="64dp"
                    android:textColor="?attr/colorOnSurface"
                    android:layout_marginBottom="8dp"
                    android:fontFamily="@font/spacemono_bold"
                    android:text="Attendance"
                    android:textAlignment="textStart"
                    android:textSize="18sp"
                    app:strokeColor="?attr/colorOnSurface"
                    app:icon="@drawable/ic_attendance"
                    app:iconGravity="start"
                    app:iconPadding="16dp"
                    app:iconSize="24dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/notesButton"
                    style="@style/Widget.Material3.Button.OutlinedButton.Icon"
                    android:layout_width="match_parent"
                    android:layout_height="64dp"
                    android:layout_marginBottom="8dp"
                    android:textColor="?attr/colorOnSurface"
                    android:fontFamily="@font/spacemono_bold"
                    android:text="My Notes"
                    app:strokeColor="?attr/colorOnSurface"
                    android:textAlignment="textStart"
                    android:textSize="18sp"
                    app:icon="@drawable/ic_notes"
                    app:iconGravity="start"
                    app:iconPadding="16dp"
                    app:iconSize="24dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/whiteboardButton"
                    style="@style/Widget.Material3.Button.OutlinedButton.Icon"
                    android:layout_width="match_parent"
                    android:layout_height="64dp"
                    android:textColor="?attr/colorOnSurface"
                    android:fontFamily="@font/spacemono_bold"
                    android:text="Whiteboard"
                    app:strokeColor="?attr/colorOnSurface"
                    android:textAlignment="textStart"
                    android:textSize="18sp"
                    app:icon="@drawable/ic_whiteboard"
                    app:iconGravity="start"
                    app:iconPadding="16dp"
                    app:iconSize="24dp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Made With Love Text -->
        <TextView
            android:id="@+id/madeWith"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="4dp"
            android:fontFamily="@font/spacemono_regular"
            android:text="Made with 🤍 and ☕"
            android:textAlignment="center"
            android:textColor="#757575"
            app:layout_constraintBottom_toTopOf="@id/bottom_nav"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent" />

        <!-- FAB for Help/Query -->
        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/query"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="16dp"
            android:layout_marginBottom="48dp"
            android:backgroundTint="?attr/colorSecondary"
            android:textColor="?attr/colorOnSecondary"
            android:contentDescription="Help"
            app:srcCompat="@drawable/question"
            app:layout_constraintBottom_toTopOf="@id/bottom_nav"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- FAB for Import -->
        <com.google.android.material.floatingactionbutton.ExtendedFloatingActionButton
            android:id="@+id/import_tt"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginBottom="48dp"
            android:fontFamily="@font/spacemono_bold"
            android:contentDescription="Import Timetable"
            android:text="Import"
            android:backgroundTint="?attr/colorSecondary"
            android:textColor="?attr/colorOnPrimary"
            app:icon="@drawable/import_tt"
            app:layout_constraintBottom_toTopOf="@id/bottom_nav"
            app:layout_constraintStart_toStartOf="parent" />

        <include
            android:id="@+id/bottom_nav"
            layout="@layout/bottom_nav"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.coordinatorlayout.widget.CoordinatorLayout>